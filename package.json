{
  "name": "@cyc-seattle/ts-config",
  "version": "0.1.0",
  "description": "Shared ESLint, Prettier, TypeScript, Vitest, and lefthook config for cyc-seattle repos",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyc-seattle/ts-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lefthook.base.yml",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0 || ~6.0.0",
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
